# Copy to .env and fill in. .env is gitignored and must never be committed.

# OpenRouter key issued with the assignment brief. Used only for the
# plain-language summary on the results screen.
OPENROUTER_API_KEY=

# The brief mandates this model and forbids more expensive ones.
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Deployed frontend origin, for CORS. Localhost is allowed automatically.
FRONTEND_ORIGIN=
